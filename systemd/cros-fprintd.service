# SPDX-License-Identifier: MIT
[Unit]
Description=fprintd-compatible service for the ChromeOS fingerprint MCU
ConditionPathExists=/dev/cros_fp
After=dbus.service

[Service]
Type=dbus
BusName=net.reactivated.Fprint
# [doc:svc-start]
# -I: isolated mode, ignores PYTHON* variables and user site-packages
ExecStart=/usr/bin/python3 -I /usr/local/libexec/cros-fprintd
Restart=on-failure
RestartSec=3

# [doc:svc-state]
# State: /var/lib/cros-fprintd, private to root
StateDirectory=cros-fprintd
StateDirectoryMode=0700
UMask=0077

# [doc:svc-sandbox]
# Filesystem: read-only system, no home directories, private /tmp, own processes only in /proc
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel and system settings it never needs to touch
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Devices: only the fingerprint MCU
DevicePolicy=closed
DeviceAllow=/dev/cros_fp rw

# No network; only Unix sockets (D-Bus); no System V IPC or kernel keyring sharing
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
PrivateIPC=yes
KeyringMode=private

# Privileges: runs as root for D-Bus policy and file ownership, but without capabilities
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# No memory that is both writable and executable (tested with the GObject bindings)
MemoryDenyWriteExecute=yes

# System calls: the usual set for system services; others fail with EPERM
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
