#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""
cros-fprintd-monitor - record when (and hints why) the fingerprint reader is unavailable

Writes one compact timeline to /var/log/cros-fprintd-monitor.log:

  STATE    a snapshot, logged at start and whenever something changes:
           service state/restarts, D-Bus name owner, API answer, /dev/cros_fp,
           MCU hello, seed/mode, sleep mode
  EVENT    suspend / resume (with S0ix residency gained during the sleep)
  JOURNAL  journal lines that matter: cros-fprintd, pam_fprintd, cros-ec errors,
           GNOME Shell / GDM fingerprint messages, suspend entry/exit
  MARK     your own note ("sudo had no fingerprint"), plus a snapshot
  SLEEP    one line per suspend: duration, battery before/after, power drawn,
           share of the time spent in S0ix (used by the 'battery' command)

Only read-only commands are sent to the MCU (hello, mode query, encryption status).

Usage:
  cros-fprintd-monitor run              (the systemd service runs this)
  sudo cros-fprintd-monitor status      print one snapshot now
  sudo cros-fprintd-monitor mark [TEXT] add a marker to the log, with a snapshot
  sudo cros-fprintd-monitor battery     average standby drain and expected standby time
"""
import fcntl
import os
import re
import struct
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

LOG = "/var/log/cros-fprintd-monitor.log"
LOG_MAX = 2 * 1024 * 1024          # rotate to .1 above 2 MB
INTERVAL = 60                      # seconds between snapshots
HEARTBEAT = 3600                   # log an unchanged snapshot at least this often
DEV = "/dev/cros_fp"
IOCXCMD = 0xC014EC00
S0IX = "/sys/kernel/debug/pmc_core/slp_s0_residency_usec"

JOURNAL_RE = re.compile(
    r"cros-fprintd|pam_fprintd|fprint|fingerprint|cros-ec|cros_ec|EC failed to respond|"
    r"sleep transition|PM: suspend (entry|exit)|net\.reactivated\.Fprint", re.I)

_lock = threading.Lock()


# ------------------------------------------------------------------ output --
# [doc:mon-log]
def log(kind, text):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {kind:<7} {text}\n"
    with _lock:
        try:
            if os.path.exists(LOG) and os.path.getsize(LOG) > LOG_MAX:
                os.replace(LOG, LOG + ".1")
            with open(LOG, "a") as f:
                f.write(line)
        except OSError as e:
            sys.stderr.write(f"cannot write {LOG}: {e}\n")


# ---------------------------------------------------------------- probing --
def ec(fd, cmd, data=b"", insize=0, ver=0):
    n = max(len(data), insize)
    buf = bytearray(struct.pack("<5I", ver, cmd, len(data), insize, 0) + data.ljust(n, b"\0"))
    ret = fcntl.ioctl(fd, IOCXCMD, buf, True)
    return struct.unpack_from("<I", buf, 16)[0], bytes(buf[20:20 + max(ret, 0)])


# [doc:mon-probe-chip]
def probe_mcu():
    """Read-only checks of the MCU. Returns a dict of short strings."""
    out = {"dev": "yes" if os.path.exists(DEV) else "MISSING"}
    if out["dev"] != "yes":
        return out
    try:
        fd = os.open(DEV, os.O_RDWR)
    except OSError as e:
        out["mcu"] = f"open-error:{e.errno}"
        return out
    try:
        res, d = ec(fd, 0x0001, struct.pack("<I", 0xA0B0C0D0), 4)          # HELLO
        ok = res == 0 and len(d) == 4 and struct.unpack("<I", d)[0] == 0xA1B2C3D4
        out["mcu"] = "ok" if ok else f"bad-hello:{res}"
        if ok:
            res, d = ec(fd, 0x0409, b"", 8)                                # FP_ENC_STATUS
            if res == 0 and len(d) == 8:
                out["seed"] = str(struct.unpack("<II", d)[1] & 1)
            res, d = ec(fd, 0x0402, struct.pack("<I", 0x80000000), 4)      # FP_MODE get
            if res == 0 and len(d) == 4:
                out["mode"] = hex(struct.unpack("<I", d)[0])
    except OSError as e:
        out["mcu"] = "TIMEOUT" if e.errno == 110 else f"ioctl-error:{e.errno}"
    finally:
        os.close(fd)
    return out


def probe_service():
    out = {}
    try:
        r = subprocess.run(["systemctl", "show", "cros-fprintd", "-p", "ActiveState",
                            "-p", "SubState", "-p", "NRestarts", "-p", "MainPID"],
                           capture_output=True, text=True, timeout=5)
        kv = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
        out["svc"] = f"{kv.get('ActiveState', '?')}/{kv.get('SubState', '?')}"
        out["pid"] = kv.get("MainPID", "?")
        out["restarts"] = kv.get("NRestarts", "?")
    except (OSError, subprocess.SubprocessError) as e:
        out["svc"] = f"error:{e.__class__.__name__}"
    return out


def probe_dbus(bus):
    out = {}
    if bus is None:
        return {"bus": "no-system-bus"}
    try:
        r = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "GetNameOwner", GLib.Variant("(s)", ("net.reactivated.Fprint",)),
                          GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 2000, None)
        out["bus"] = r.unpack()[0]
    except GLib.Error:
        out["bus"] = "NO-OWNER"
        return out
    try:
        bus.call_sync("net.reactivated.Fprint", "/net/reactivated/Fprint/Manager",
                      "net.reactivated.Fprint.Manager", "GetDefaultDevice", None,
                      GLib.VariantType("(o)"), Gio.DBusCallFlags.NO_AUTO_START, 3000, None)
        out["api"] = "ok"
    except GLib.Error as e:
        name = Gio.DBusError.get_remote_error(e) or e.message
        out["api"] = "TIMEOUT" if "Timeout" in str(name) or "timed out" in e.message else f"error:{name}"
    return out


def read_first(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def sleep_mode():
    m = re.search(r"\[(\w+)\]", read_first("/sys/power/mem_sleep"))
    return m.group(1) if m else "?"


def s0ix_usec():
    v = read_first(S0IX)
    return int(v) if v.isdigit() else None


def power_supplies():
    """Return (battery dir or None, list of mains/usb dirs)."""
    base = "/sys/class/power_supply"
    bat, ac = None, []
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return None, []
    for n in names:
        t = read_first(f"{base}/{n}/type")
        if t == "Battery" and bat is None:
            bat = f"{base}/{n}"
        elif t in ("Mains", "USB"):
            ac.append(f"{base}/{n}")
    return bat, ac


# [doc:mon-battery]
def battery_state():
    """Energy now/full in mWh, capacity in %, and whether external power is connected."""
    bat, ac = power_supplies()
    if bat is None:
        return None

    def num(name):
        v = read_first(f"{bat}/{name}")
        return int(v) if v.lstrip("-").isdigit() else None

    e_now, e_full = num("energy_now"), num("energy_full")          # uWh
    if e_now is None or e_full is None:                            # charge-based battery
        c_now, c_full = num("charge_now"), num("charge_full")      # uAh
        volt = num("voltage_min_design") or num("voltage_now")     # uV
        if None in (c_now, c_full, volt):
            return None
        e_now, e_full = c_now * volt // 1_000_000, c_full * volt // 1_000_000
    on_ac = any(read_first(f"{d}/online") == "1" for d in ac)
    return {"e_mwh": e_now / 1000, "full_mwh": e_full / 1000,
            "pct": num("capacity"), "ac": on_ac}


# [doc:mon-snapshot]
def snapshot(bus):
    s = {}
    s.update(probe_service())
    s.update(probe_dbus(bus))
    s.update(probe_mcu())
    s["sleep"] = sleep_mode()
    problems = []
    if not s.get("svc", "").startswith("active/running"):
        problems.append("service-not-running")
    if s.get("bus") in ("NO-OWNER", "no-system-bus"):
        problems.append("no-dbus-owner")
    elif s.get("api") != "ok":
        problems.append("api-not-answering")
    if s.get("dev") != "yes":
        problems.append("no-device-node")
    elif s.get("mcu") != "ok":
        problems.append("mcu-not-answering")
    if s["sleep"] != "s2idle":
        problems.append("sleep-mode-not-s2idle")
    s["avail"] = "yes" if not problems else "NO(" + ",".join(problems) + ")"
    return s


def fmt(s):
    order = ["avail", "svc", "pid", "restarts", "bus", "api", "dev", "mcu", "seed", "mode", "sleep"]
    return " ".join(f"{k}={s[k]}" for k in order if k in s)


# ------------------------------------------------------------------- agent --
class Agent:
    STABLE = ("avail", "svc", "pid", "restarts", "bus", "api", "dev", "mcu", "seed", "mode", "sleep")

    def __init__(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error as e:
            log("ERROR", f"no system bus: {e.message}")
            self.bus = None
        self.last = None
        self.last_logged = 0.0
        self.s0ix_before_sleep = None
        self.sleep_start = None          # (wall time, battery state)
        self.inhibit_fd = None

    def check(self, reason="poll"):
        s = snapshot(self.bus)
        key = tuple(s.get(k) for k in self.STABLE)
        now = time.monotonic()
        if self.last is None or key != self.last or now - self.last_logged > HEARTBEAT:
            tag = "" if reason == "poll" else f"[{reason}] "
            if self.last is not None and key != self.last:
                old = dict(zip(self.STABLE, self.last))
                changed = [k for k in self.STABLE if old.get(k) != s.get(k)]
                tag += "changed:" + ",".join(changed) + " "
            log("STATE", tag + fmt(s))
            self.last, self.last_logged = key, now
        return True

    # [doc:mon-inhibit]
    def take_inhibitor(self):
        """Hold a logind 'delay' lock so the pre-sleep readings are taken before sleeping."""
        if self.bus is None or self.inhibit_fd is not None:
            return
        try:
            res, fds = self.bus.call_with_unix_fd_list_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1",
                "org.freedesktop.login1.Manager", "Inhibit",
                GLib.Variant("(ssss)", ("sleep", "cros-fprintd-monitor",
                                        "record battery and S0ix before sleeping", "delay")),
                GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, 5000, None, None)
            self.inhibit_fd = fds.get(res.unpack()[0])
        except GLib.Error as e:
            log("ERROR", f"cannot take sleep delay lock: {e.message}")

    def release_inhibitor(self):
        if self.inhibit_fd is not None:
            os.close(self.inhibit_fd)
            self.inhibit_fd = None

    def on_prepare_for_sleep(self, conn, sender, path, iface, signal, params):
        going_down = params.unpack()[0]
        if going_down:
            self.s0ix_before_sleep = s0ix_usec()
            self.sleep_start = (time.time(), battery_state())
            b = self.sleep_start[1]
            batt = f", battery {b['pct']}%{' on AC' if b['ac'] else ''}" if b else ""
            log("EVENT", f"suspend (sleep mode {sleep_mode()}{batt})")
            self.release_inhibitor()                  # let the system go to sleep now
        else:
            self.take_inhibitor()
            self.log_sleep()
            for delay in (3, 15, 60):
                GLib.timeout_add_seconds(delay, self._once, f"resume+{delay}s")

    # [doc:mon-sleep]
    def log_sleep(self):
        after = s0ix_usec()
        s0ix_s = None
        if after is not None and self.s0ix_before_sleep is not None:
            s0ix_s = (after - self.s0ix_before_sleep) / 1e6
        if self.sleep_start is None:
            log("EVENT", "resume (no pre-sleep readings)")
            return
        t0, b0 = self.sleep_start
        self.sleep_start = None
        dur = time.time() - t0
        b1 = battery_state()
        parts = [f"slept {dur / 3600:.2f} h"]
        if s0ix_s is not None and dur > 0:
            parts.append(f"S0ix {s0ix_s:.0f} s ({min(100.0, 100 * s0ix_s / dur):.0f}%)")
        record = f"dur_s={dur:.0f} s0ix_s={s0ix_s if s0ix_s is not None else -1:.0f}"
        if b0 and b1:
            used = b0["e_mwh"] - b1["e_mwh"]
            ac = b0["ac"] or b1["ac"]
            record += (f" e0_mwh={b0['e_mwh']:.0f} e1_mwh={b1['e_mwh']:.0f}"
                       f" full_mwh={b1['full_mwh']:.0f} pct0={b0['pct']} pct1={b1['pct']}"
                       f" ac={int(ac)}")
            if ac:
                parts.append("on AC (not counted for battery statistics)")
            elif dur >= 60:
                watts = used / 1000 / (dur / 3600)
                pct_h = (b0["pct"] - b1["pct"]) / (dur / 3600) if None not in (b0["pct"], b1["pct"]) else None
                parts.append(f"battery {b0['pct']}% -> {b1['pct']}%, {used / 1000:.2f} Wh, "
                             f"{watts * 1000:.0f} mW average")
                if pct_h is not None:
                    parts.append(f"{pct_h:.2f} %/h")
                if watts > 0 and dur >= 600:
                    parts.append(f"standby from full ~{b1['full_mwh'] / 1000 / watts / 24:.1f} days")
                elif dur < 600:
                    parts.append("too short for a standby estimate")
        log("EVENT", "resume: " + ", ".join(parts))
        log("SLEEP", record)

    def _once(self, reason):
        self.check(reason)
        return False

    # [doc:mon-journal]
    def follow_journal(self):
        try:
            p = subprocess.Popen(["journalctl", "-f", "-n", "0", "-o", "short-iso"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError as e:
            log("ERROR", f"cannot follow journal: {e}")
            return
        for line in p.stdout:
            if JOURNAL_RE.search(line) and "cros-fprintd-monitor" not in line:
                log("JOURNAL", line.rstrip()[:400])

    def run(self):
        if os.path.isdir("/sys/kernel/debug") and not os.path.exists(S0IX):
            subprocess.run(["mount", "-t", "debugfs", "none", "/sys/kernel/debug"],
                           stderr=subprocess.DEVNULL)
        log("START", f"monitor started, polling every {INTERVAL} s")
        self.check("start")
        if self.bus is not None:
            self.bus.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager",
                                      "PrepareForSleep", "/org/freedesktop/login1", None,
                                      Gio.DBusSignalFlags.NONE, self.on_prepare_for_sleep)
            self.take_inhibitor()
        threading.Thread(target=self.follow_journal, daemon=True).start()
        GLib.timeout_add_seconds(INTERVAL, self.check)
        GLib.MainLoop().run()


# [doc:mon-report]
def battery_report(min_minutes=10):
    """Summarise the SLEEP records: average standby power and expected standby time."""
    rows = []
    for path in (LOG + ".1", LOG):
        try:
            with open(path) as f:
                for line in f:
                    if " SLEEP " not in line:
                        continue
                    kv = dict(x.split("=", 1) for x in line.split() if "=" in x)
                    rows.append((line[:19], kv))
        except OSError:
            pass
    usable = [(t, kv) for t, kv in rows
              if "e0_mwh" in kv and kv.get("ac") == "0" and float(kv["dur_s"]) >= min_minutes * 60]
    print(f"sleep periods logged: {len(rows)}, on battery and >= {min_minutes} min: {len(usable)}")
    if not usable:
        print("Not enough data yet: suspend on battery for a while (overnight is ideal), then try again.")
        return
    total_h = sum(float(kv["dur_s"]) for _, kv in usable) / 3600
    total_wh = sum(float(kv["e0_mwh"]) - float(kv["e1_mwh"]) for _, kv in usable) / 1000
    full_wh = float(usable[-1][1]["full_mwh"]) / 1000
    s0ix = [float(kv["s0ix_s"]) / float(kv["dur_s"]) for _, kv in usable if float(kv.get("s0ix_s", -1)) >= 0]
    for t, kv in usable[-10:]:
        h = float(kv["dur_s"]) / 3600
        wh = (float(kv["e0_mwh"]) - float(kv["e1_mwh"])) / 1000
        print(f"  {t}  {h:5.2f} h  {kv['pct0']:>3}% -> {kv['pct1']:>3}%  {wh * 1000 / h:6.0f} mW")
    watts = total_wh / total_h if total_h else 0
    print(f"total: {total_h:.1f} h asleep on battery, {total_wh:.2f} Wh used")
    print(f"average standby power: {watts * 1000:.0f} mW ({100 * watts / full_wh:.2f} % of a full battery per hour)")
    if s0ix:
        print(f"average share of sleep time in S0ix: {100 * sum(s0ix) / len(s0ix):.0f} %")
    if watts > 0:
        print(f"expected standby time from full: ~{full_wh / watts:.0f} h (~{full_wh / watts / 24:.1f} days)"
              f" (battery now holds {full_wh:.1f} Wh when full)")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        Agent().run()
    elif cmd == "status":
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            bus = None
        print(fmt(snapshot(bus)))
    elif cmd == "mark":
        text = " ".join(sys.argv[2:]) or "(no text)"
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            bus = None
        s = snapshot(bus)
        log("MARK", text)
        log("STATE", "[mark] " + fmt(s))
        print("marked:", fmt(s))
    elif cmd == "battery":
        battery_report()
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
