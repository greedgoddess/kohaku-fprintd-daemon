# ---------------------------------------------------------------- constants --
CROS_EC_DEV_IOCXCMD = 0xC014EC00          # _IOWR(0xEC, 0, struct cros_ec_command)
CROS_EC_DEV_IOCEVENTMASK = 0xEC02         # _IO(0xEC, 2), argument = event mask
EC_MKBP_EVENT_FINGERPRINT = 5

CMD_FP_MODE = 0x0402
CMD_FP_INFO = 0x0403
CMD_FP_FRAME = 0x0404
CMD_FP_TEMPLATE = 0x0405
CMD_FP_CONTEXT = 0x0406
CMD_FP_SEED = 0x0408
CMD_FP_ENC_STATUS = 0x0409

MODE_IDLE = 0
MODE_ENROLL = (1 << 4) | (1 << 5)         # ENROLL_SESSION | ENROLL_IMAGE
MODE_MATCH = 1 << 6

EV_ENROLL = 1 << 27
EV_MATCH = 1 << 28

SEED_STRUCT_VERSION = 4
TEMPLATE_COMMIT = 0x80000000
CHUNK = 512
MAX_TEMPLATE_BYTES = 1 << 20               # sanity limit for MCU-reported and on-disk templates
MAX_TEMPLATES = 15                         # the frame index has 4 bits (index 1..15)
MAX_FAILED_MATCHES = 5                     # consecutive failures before a lockout
LOCKOUT_SECONDS = 600                      # fingerprint refused for 10 minutes after that
ENROLL_STAGES = 12                         # estimate; GNOME uses it for its progress ring

BUS_TYPE = Gio.BusType.SYSTEM            # the test harness switches this to SESSION
BUS_NAME = "net.reactivated.Fprint"
MGR_PATH = "/net/reactivated/Fprint/Manager"
DEV_PATH = "/net/reactivated/Fprint/Device/0"
MGR_IFACE = "net.reactivated.Fprint.Manager"
DEV_IFACE = "net.reactivated.Fprint.Device"
ERR = "net.reactivated.Fprint.Error."

FINGERS = {
    f"{side}-{name}"
    for side in ("left", "right")
    for name in ("thumb", "index-finger", "middle-finger", "ring-finger", "little-finger")
}

