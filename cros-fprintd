class FprintError(Exception):
    """Error reported to the D-Bus caller as net.reactivated.Fprint.Error.<name>."""

    def __init__(self, name, message):
        super().__init__(message)
        self.name = ERR + name


class McuError(Exception):
    pass


# ----------------------------------------------------------------- hardware --
class Mcu:
    """The fingerprint MCU behind /dev/cros_fp."""

    def __init__(self, path):
        self.fd = os.open(path, os.O_RDWR)
        self.lock = threading.Lock()
        fcntl.ioctl(self.fd, CROS_EC_DEV_IOCEVENTMASK, 1 << EC_MKBP_EVENT_FINGERPRINT)
        self._template_size = None

    def xfer(self, cmd, ver=0, data=b"", insize=0):
        n = max(len(data), insize)
        buf = bytearray(struct.pack("<5I", ver, cmd, len(data), insize, 0) + data.ljust(n, b"\0"))
        with self.lock:
            try:
                ret = fcntl.ioctl(self.fd, CROS_EC_DEV_IOCXCMD, buf, True)
            except OSError as e:
                raise McuError(f"ioctl for command 0x{cmd:04x} failed: {e}") from e
        result = struct.unpack_from("<I", buf, 16)[0]
        return result, bytes(buf[20:20 + max(ret, 0)])

    def _ok(self, cmd, ver=0, data=b"", insize=0):
        result, out = self.xfer(cmd, ver, data, insize)
        if result != 0:
            raise McuError(f"command 0x{cmd:04x} v{ver} returned EC result {result}")
        return out

    def enc_status(self):
        out = self._ok(CMD_FP_ENC_STATUS, 0, b"", 8)
        return struct.unpack("<II", out)[1]

    def ensure_seed(self, seed, seed_is_new):
        if self.enc_status() & 1:
            if seed_is_new:
                raise McuError(
                    "the MCU already has a seed from another program this boot, but "
                    "no seed file existed. Reboot (or install the seed that was used) "
                    "so enrolled fingers stay decryptable after the next boot.")
            return
        self._ok(CMD_FP_SEED, 0, struct.pack("<HH", SEED_STRUCT_VERSION, 0) + seed)
        log.info("seed set")

    def set_context(self, userid):
        """Set the user context. This clears all templates held by the MCU."""
        self._ok(CMD_FP_CONTEXT, 1, struct.pack("<B3x", 0) + userid)
        poll = struct.pack("<B3x", 1) + userid
        for _ in range(100):
            result, _ = self.xfer(CMD_FP_CONTEXT, 1, poll)
            if result == 0:
                return
            time.sleep(0.1)
        raise McuError("timed out waiting for the user context to be set")

    def info(self):
        b = self._ok(CMD_FP_INFO, 1, b"", 48)
        if len(b) < 48:
            raise McuError("short fp_info reply")
        tsize, = struct.unpack_from("<I", b, 32)
        tmax, tvalid = struct.unpack_from("<HH", b, 36)
        dirty, = struct.unpack_from("<I", b, 40)
        if not 0 < tsize <= MAX_TEMPLATE_BYTES or not 0 < tmax <= MAX_TEMPLATES or tvalid > tmax:
            raise McuError(f"implausible fp_info reply (size {tsize}, max {tmax}, valid {tvalid})")
        self._template_size = tsize
        return {"template_size": tsize, "max": tmax, "valid": tvalid, "dirty": dirty}

    @property
    def template_size(self):
        if self._template_size is None:
            self.info()
        return self._template_size

    def _chunks(self):
        size = self.template_size
        for off in range(0, size, CHUNK):
            yield off, min(CHUNK, size - off), off + CHUNK >= size

    def load_template(self, blob):
        if len(blob) != self.template_size:
            raise McuError(f"stored template is {len(blob)} bytes, expected {self.template_size}")
        for off, n, last in self._chunks():
            hdr = struct.pack("<II", off, n | (TEMPLATE_COMMIT if last else 0))
            self._ok(CMD_FP_TEMPLATE, 0, hdr + blob[off:off + n])

    def read_template(self, index):
        if not 0 <= index < MAX_TEMPLATES:
            raise McuError(f"template index {index} out of range")
        out = bytearray()
        for off, n, _ in self._chunks():
            part = self._ok(CMD_FP_FRAME, 0, struct.pack("<II", ((index + 1) << 28) | off, n), n)
            if len(part) != n:
                raise McuError("short template read")
            out += part
        return bytes(out)

    def set_mode(self, mode):
        self._ok(CMD_FP_MODE, 0, struct.pack("<I", mode), 4)

    def drain_events(self):
        while select.select([self.fd], [], [], 0)[0]:
            os.read(self.fd, 64)

    def wait_event(self, timeout):
        """Return the next fingerprint event word, or None on timeout."""
        if not select.select([self.fd], [], [], timeout)[0]:
            return None
        buf = os.read(self.fd, 64)
        if len(buf) >= 5 and buf[0] == EC_MKBP_EVENT_FINGERPRINT:
            return struct.unpack_from("<I", buf, 1)[0]
        return None


# ------------------------------------------------------------------ storage --
def atomic_write(path, data):
    """Write through an unpredictable temporary file in the same directory, then rename."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=d)        # O_EXCL, mode 0600
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise
    dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def check_private(st, path):
    """Refuse files that aren't ours alone (regular file, owner = us, no group/other bits)."""
    if not stat.S_ISREG(st.st_mode):
        raise PermissionError(f"{path} is not a regular file")
    if st.st_uid != os.geteuid():
        raise PermissionError(f"{path} is owned by uid {st.st_uid}, expected {os.geteuid()}")
    if st.st_mode & 0o077:
        raise PermissionError(f"{path} is accessible to other users "
                              f"(mode {oct(stat.S_IMODE(st.st_mode))})")


def read_private(path, max_bytes):
    """Read a private regular file without following symlinks, with a size limit."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        check_private(st, path)
        if st.st_size > max_bytes:
            raise ValueError(f"{path} is too large ({st.st_size} bytes)")
        return os.read(fd, max_bytes + 1)
    finally:
        os.close(fd)


def ensure_private_dir(path):
    """Create the directory if needed. It must be a real directory owned by us; group and
    other permissions are removed if present (the files inside are checked separately)."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        raise PermissionError(f"{path} must be a directory owned by uid {os.geteuid()}")
    if st.st_mode & 0o077:
        log.warning("tightening permissions of %s (was %s)", path, oct(stat.S_IMODE(st.st_mode)))
        os.chmod(path, 0o700)


class Store:
    """Seed and per-user templates under the state directory (all private to root)."""

    def __init__(self, root):
        self.root = root
        self.lock = threading.RLock()
        self._generation = {}            # bumped on deletion, so late writes can't resurrect prints
        ensure_private_dir(root)
        ensure_private_dir(os.path.join(root, "users"))
        seed_path = os.path.join(root, "seed")
        self.seed_is_new = False
        try:
            self.seed = read_private(seed_path, 32)
        except FileNotFoundError:
            self.seed = os.urandom(32)
            atomic_write(seed_path, self.seed)
            self.seed_is_new = True
            log.info("created new seed file %s", seed_path)
        if len(self.seed) != 32:
            raise ValueError(f"{seed_path} must be exactly 32 bytes")

    def userid(self, user):
        return hmac.new(self.seed, b"cros-fprintd user:" + user.encode(), hashlib.sha256).digest()

    def _dir(self, user):
        if not user or "/" in user or user.startswith("."):
            raise FprintError("Internal", "bad user name")
        return os.path.join(self.root, "users", user)

    def generation(self, user):
        with self.lock:
            return self._generation.get(user, 0)

    def fingers(self, user):
        """Enrolled finger names in MCU load order."""
        d = self._dir(user)
        path = os.path.join(d, "fingers.json")
        try:
            data = json.loads(read_private(path, 4096))
        except FileNotFoundError:
            return []
        except (ValueError, PermissionError) as e:        # JSONDecodeError is a ValueError
            log.error("ignoring %s: %s", path, e)
            return []
        order = data.get("order") if isinstance(data, dict) else None
        if not isinstance(order, list) or not all(isinstance(x, str) for x in order):
            log.error("ignoring %s: expected {\"order\": [finger names]}", path)
            return []
        result = []
        for name in order:
            if name not in FINGERS:
                log.warning("%s: ignoring unknown finger name %r", path, name)
            elif name in result:
                log.warning("%s: ignoring duplicate entry %r", path, name)
            elif not os.path.exists(os.path.join(d, name + ".bin")):
                log.warning("%s: template for %r is missing", path, name)
            else:
                result.append(name)
        return result

    def read_finger(self, user, finger):
        return read_private(os.path.join(self._dir(user), finger + ".bin"), MAX_TEMPLATE_BYTES)

    def save(self, user, generation, templates=None, order=None):
        """Write templates ({finger: blob}) and/or the finger order, unless prints were
        deleted since `generation` was taken. Returns False if skipped."""
        with self.lock:
            if generation != self._generation.get(user, 0):
                log.info("not saving fingers of %s: they were deleted meanwhile", user)
                return False
            d = self._dir(user)
            ensure_private_dir(d)
            for finger, blob in (templates or {}).items():
                atomic_write(os.path.join(d, finger + ".bin"), blob)
            if order is not None:
                atomic_write(os.path.join(d, "fingers.json"), json.dumps({"order": order}).encode())
            return True

    def delete_all(self, user):
        with self.lock:
            self._generation[user] = self._generation.get(user, 0) + 1
            d = self._dir(user)
            for name in [f + ".bin" for f in FINGERS] + ["fingers.json"]:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(os.path.join(d, name))


# ------------------------------------------------------------------ service --
class Lockout:
    """Refuse fingerprint verification for a while after repeated failed matches.

    Kept in memory only; the password always remains available.
    """

    def __init__(self):
        self._lock = threading.Lock()
        self._failures = {}
        self._until = {}

    def locked(self, user):
        with self._lock:
            return time.monotonic() < self._until.get(user, 0)

    def failed(self, user):
        with self._lock:
            n = self._failures.get(user, 0) + 1
            self._failures[user] = n
            if n >= MAX_FAILED_MATCHES:
                self._failures[user] = 0
                self._until[user] = time.monotonic() + LOCKOUT_SECONDS
                log.warning("%d failed matches for %s: fingerprint locked for %d s",
                            n, user, LOCKOUT_SECONDS)

    def succeeded(self, user):
        with self._lock:
            self._failures.pop(user, None)


class Session:
    def __init__(self, kind, user):
        self.kind = kind                      # "verify" or "enroll"
        self.user = user
        self.stop = threading.Event()         # asks the worker to end
        self.finished = threading.Event()     # worker has ended
        self.thread = None
        self.waiters = []                     # pending VerifyStop/EnrollStop replies
        self.released = False                 # claim dropped; forget the session once it ends


class Service:
    def __init__(self, conn, mcu, store):
        self.conn = conn
        self.mcu = mcu
        self.store = store
        self.claimed_by = None
        self.user = None
        self.session = None
        self.finger_needed = False
        self.lockout = Lockout()

    # -- helpers ----------------------------------------------------------
    def _emit(self, signal, fmt, args):
        def do():
            self.conn.emit_signal(None, DEV_PATH, DEV_IFACE, signal, GLib.Variant(fmt, args))
            return False
        GLib.idle_add(do)

    def _set_finger_needed(self, value):
        def do():
            self.finger_needed = value
            self.conn.emit_signal(
                None, DEV_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                GLib.Variant("(sa{sv}as)", (DEV_IFACE, {"finger-needed": GLib.Variant("b", value)}, [])))
            return False
        GLib.idle_add(do)

    def _caller_uid(self, sender):
        reply = self.conn.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
            "GetConnectionUnixUser", GLib.Variant("(s)", (sender,)), GLib.VariantType("(u)"),
            Gio.DBusCallFlags.NONE, -1, None)
        return reply.unpack()[0]

    def _resolve_user(self, sender, username):
        """Return the user the call is for, enforcing: same user or root."""
        uid = self._caller_uid(sender)
        if not username:
            try:
                return pwd.getpwuid(uid).pw_name
            except KeyError:
                raise FprintError("PermissionDenied", "unknown calling user")
        try:
            target = pwd.getpwnam(username).pw_uid
        except KeyError:
            raise FprintError("PermissionDenied", f"unknown user {username!r}")
        if uid != 0 and uid != target:
            raise FprintError("PermissionDenied", "not allowed to act for another user")
        return username

    def _require_claim(self, sender):
        if self.claimed_by is None or self.claimed_by != sender:
            raise FprintError("ClaimDevice", "Device was not claimed before use")

    # -- device methods ---------------------------------------------------
    def m_ListEnrolledFingers(self, sender, args):
        user = self._resolve_user(sender, args[0])
        fingers = self.store.fingers(user)
        if not fingers:
            raise FprintError("NoEnrolledPrints", "Failed to discover prints")
        return GLib.Variant("(as)", (fingers,))

    def m_DeleteEnrolledFingers(self, sender, args):
        user = self._resolve_user(sender, args[0])
        self.store.delete_all(user)

    def m_DeleteEnrolledFingers2(self, sender, args):
        self._require_claim(sender)
        self.store.delete_all(self.user)

    def m_Claim(self, sender, args):
        user = self._resolve_user(sender, args[0])
        if self.claimed_by is not None:
            raise FprintError("AlreadyInUse", "Device was already claimed")
        self.claimed_by, self.user = sender, user
        log.info("device claimed by %s for user %s", sender, user)

    def m_Release(self, sender, args):
        self._require_claim(sender)
        self.release()

    def release(self):
        """Drop the claim. A running worker is told to stop, and the device stays busy
        until it has really ended, so two workers never use the MCU at the same time."""
        sess = self.session
        if sess:
            sess.stop.set()
            sess.released = True
            if sess.finished.is_set():
                self.session = None
        self.claimed_by = self.user = None

    def _start(self, kind, target, finger):
        if self.session is not None:
            raise FprintError("AlreadyInUse", "Device is busy")
        sess = Session(kind, self.user)
        self.session = sess

        def run():
            try:
                target(sess.user, finger, sess.stop)
            finally:
                sess.finished.set()
                GLib.idle_add(self._worker_finished, sess)

        sess.thread = threading.Thread(target=run, name=kind, daemon=True)
        # start after the method reply has been sent (see dispatch)
        return sess

    def _worker_finished(self, sess):
        if self.session is sess and (sess.waiters or sess.released):
            self.session = None
            for inv in sess.waiters:
                inv.return_value(None)
            sess.waiters = []
        return False

    def _stop(self, sender, invocation, kind):
        self._require_claim(sender)
        sess = self.session
        if sess is None or sess.kind != kind:
            raise FprintError("NoActionInProgress", f"No {kind} in progress")
        sess.stop.set()
        if sess.finished.is_set():
            self.session = None
            return True
        sess.waiters.append(invocation)
        return False                         # reply sent later by _worker_finished

    def m_VerifyStart(self, sender, args):
        self._require_claim(sender)
        finger = args[0] or "any"
        if finger != "any" and finger not in FINGERS:
            raise FprintError("InvalidFingername", "Invalid finger name")
        if not self.store.fingers(self.user):
            raise FprintError("NoEnrolledPrints", "No enrolled prints for user")
        if self.lockout.locked(self.user):
            raise FprintError("Internal", "Too many failed attempts; use your password")
        return self._start("verify", self._verify_worker, finger)

    def m_EnrollStart(self, sender, args):
        self._require_claim(sender)
        finger = args[0]
        if finger not in FINGERS:
            raise FprintError("InvalidFingername", "Invalid finger name")
        return self._start("enroll", self._enroll_worker, finger)

    # -- MCU workflows (run in worker threads) -----------------------------
    def _prepare_user(self, user, fingers, stop):
        """Seed + context + load the given fingers' templates. Returns the loaded names."""
        self.mcu.ensure_seed(self.store.seed, self.store.seed_is_new)
        self.store.seed_is_new = False
        self.mcu.set_context(self.store.userid(user))
        loaded = []
        for f in fingers:
            if stop.is_set():
                break
            try:
                self.mcu.load_template(self.store.read_finger(user, f))
                loaded.append(f)
            except (McuError, OSError, ValueError) as e:
                log.error("could not load %s for %s: %s", f, user, e)
        return loaded

    def _save_if_dirty(self, user, loaded, generation):
        try:
            if loaded and self.mcu.info()["dirty"]:
                blobs = {f: self.mcu.read_template(i) for i, f in enumerate(loaded)}
                if self.store.save(user, generation, templates=blobs):
                    log.info("saved updated templates for %s", user)
        except (McuError, OSError) as e:
            log.error("could not save updated templates for %s: %s", user, e)

    def _finish_mcu(self):
        self._set_finger_needed(False)
        try:
            self.mcu.set_mode(MODE_IDLE)
        except McuError as e:
            log.error("could not set idle mode: %s", e)

    def _verify_worker(self, user, finger, stop):
        loaded, generation = [], self.store.generation(user)
        try:
            loaded = self._prepare_user(user, self.store.fingers(user), stop)
            if not loaded:
                self._emit("VerifyStatus", "(sb)", ("verify-unknown-error", True))
                return
            self.mcu.drain_events()
            self.mcu.set_mode(MODE_MATCH)
            self._emit("VerifyFingerSelected", "(s)", (finger,))
            self._set_finger_needed(True)
            while not stop.is_set():
                ev = self.mcu.wait_event(0.25)
                if ev is None or not ev & EV_MATCH:
                    continue
                err, idx = ev & 0xF, (ev >> 12) & 0xF
                if err in (1, 3, 5):
                    if idx >= len(loaded):        # never trust an index we didn't load
                        log.warning("MCU reported a match for invalid template index %d", idx)
                        self.lockout.failed(user)
                        self._emit("VerifyStatus", "(sb)", ("verify-unknown-error", True))
                        return
                    if self.store.generation(user) != generation:
                        log.warning("ignoring match for %s: fingers were deleted during verify", user)
                        self._emit("VerifyStatus", "(sb)", ("verify-no-match", True))
                        return
                    name = loaded[idx]
                    ok = finger in ("any", name)
                    log.info("match for %s: %s%s", user, name, "" if ok else f" (wanted {finger})")
                    (self.lockout.succeeded if ok else self.lockout.failed)(user)
                    self._emit("VerifyStatus", "(sb)", ("verify-match" if ok else "verify-no-match", True))
                    return
                if err == 0:
                    log.info("no match for %s", user)
                    self.lockout.failed(user)
                    self._emit("VerifyStatus", "(sb)", ("verify-no-match", True))
                    return
                if err in (2, 4):                     # low quality / low coverage
                    self._emit("VerifyStatus", "(sb)", ("verify-retry-scan", False))
                    self.mcu.set_mode(MODE_MATCH)
                    continue
                log.warning("MCU match error code %d for %s", err, user)
                self._emit("VerifyStatus", "(sb)", ("verify-unknown-error", True))
                return
        except (McuError, OSError, ValueError) as e:
            log.error("verify failed: %s", e)
            self._emit("VerifyStatus", "(sb)", ("verify-unknown-error", True))
        except Exception:                             # noqa: BLE001 - a bug; report, don't crash
            log.exception("unexpected error during verify")
            self._emit("VerifyStatus", "(sb)", ("verify-unknown-error", True))
        finally:
            self._finish_mcu()
            self._save_if_dirty(user, loaded, generation)

    def _enroll_worker(self, user, finger, stop):
        generation = self.store.generation(user)
        try:
            others = [f for f in self.store.fingers(user) if f != finger]
            loaded = self._prepare_user(user, others, stop)
            if len(loaded) >= self.mcu.info()["max"]:
                self._emit("EnrollStatus", "(sb)", ("enroll-data-full", True))
                return
            index = len(loaded)
            self.mcu.drain_events()
            self.mcu.set_mode(MODE_ENROLL)
            self._set_finger_needed(True)
            last_event = time.monotonic()
            while not stop.is_set():
                ev = self.mcu.wait_event(0.25)
                if ev is None:
                    if time.monotonic() - last_event > 300:
                        self._emit("EnrollStatus", "(sb)", ("enroll-failed", True))
                        return
                    continue
                if not ev & EV_ENROLL:
                    continue
                last_event = time.monotonic()
                err, progress = ev & 0xF, (ev >> 4) & 0xFF
                if progress >= 100 and err in (0, 2):
                    self.mcu.set_mode(MODE_IDLE)
                    blob = self.mcu.read_template(index)
                    if self.store.save(user, generation, templates={finger: blob}, order=others + [finger]):
                        log.info("enrolled %s for %s", finger, user)
                        self._emit("EnrollStatus", "(sb)", ("enroll-completed", True))
                    else:
                        self._emit("EnrollStatus", "(sb)", ("enroll-failed", True))
                    return
                if err in (0, 2):        # progress advanced (2 = finger did not move)
                    self._emit("EnrollStatus", "(sb)", ("enroll-stage-passed", False))
                elif err == 1:
                    self._emit("EnrollStatus", "(sb)", ("enroll-retry-scan", False))
                elif err == 3:
                    self._emit("EnrollStatus", "(sb)", ("enroll-finger-not-centered", False))
                else:
                    log.warning("MCU enroll error code %d for %s", err, user)
                    self._emit("EnrollStatus", "(sb)", ("enroll-failed", True))
                    return
                self.mcu.set_mode(MODE_ENROLL)
        except (McuError, OSError, ValueError) as e:
            log.error("enroll failed: %s", e)
            self._emit("EnrollStatus", "(sb)", ("enroll-failed", True))
        except Exception:                             # noqa: BLE001
            log.exception("unexpected error during enroll")
            self._emit("EnrollStatus", "(sb)", ("enroll-failed", True))
        finally:
            self._finish_mcu()

    # -- D-Bus plumbing ---------------------------------------------------
    def on_name_owner_changed(self, conn, sender, path, iface, signal, params):
        name, _old, new = params.unpack()
        if new == "" and name == self.claimed_by:
            log.info("client %s vanished; releasing device", name)
            self.release()

    def _who(self, sender):
        try:
            return f"{sender} (uid {self._caller_uid(sender)})"
        except Exception:                             # noqa: BLE001
            return sender

    def get_property(self, conn, sender, path, iface, prop):
        log.debug("property %s read by %s", prop, sender)
        values = {
            "name": GLib.Variant("s", "ChromeOS fingerprint MCU"),
            "scan-type": GLib.Variant("s", "press"),
            "num-enroll-stages": GLib.Variant("i", ENROLL_STAGES),
            "finger-present": GLib.Variant("b", False),
            "finger-needed": GLib.Variant("b", self.finger_needed),
        }
        return values.get(prop)

    def device_call(self, conn, sender, path, iface, method, params, invocation):
        handler = getattr(self, "m_" + method, None)
        if log.isEnabledFor(logging.DEBUG):
            log.debug("call %s%s from %s", method, params.unpack(), self._who(sender))
        try:
            if method in ("VerifyStop", "EnrollStop"):
                if self._stop(sender, invocation, "verify" if method == "VerifyStop" else "enroll"):
                    invocation.return_value(None)
                return
            if handler is None:
                raise FprintError("Internal", f"unknown method {method}")
            result = handler(sender, params.unpack())
            if isinstance(result, Session):           # VerifyStart / EnrollStart
                invocation.return_value(None)
                result.thread.start()
            else:
                invocation.return_value(result)
        except FprintError as e:
            if e.name.endswith(("PermissionDenied", "ClaimDevice", "AlreadyInUse", "Internal")):
                log.warning("refused %s from %s: %s (%s)", method, self._who(sender),
                            e.name.rsplit(".", 1)[-1], e)
            invocation.return_dbus_error(e.name, str(e))
        except Exception:                             # noqa: BLE001
            # details go to the journal only, not to (possibly unprivileged) callers
            log.exception("method %s failed", method)
            invocation.return_dbus_error(ERR + "Internal", "Internal error, see the system journal")

    def manager_call(self, conn, sender, path, iface, method, params, invocation):
        if log.isEnabledFor(logging.DEBUG):
            log.debug("call %s from %s", method, self._who(sender))
        if method == "GetDevices":
            invocation.return_value(GLib.Variant("(ao)", ([DEV_PATH],)))
        elif method == "GetDefaultDevice":
            invocation.return_value(GLib.Variant("(o)", (DEV_PATH,)))
        else:
            invocation.return_dbus_error(ERR + "Internal", f"unknown method {method}")


# --------------------------------------------------------------------- main --
def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    ap.add_argument("--device", default="/dev/cros_fp")
    ap.add_argument("--state-dir", default="/var/lib/cros-fprintd")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(levelname)s %(message)s")

    try:
        store = Store(args.state_dir)
    except (OSError, ValueError) as e:
        log.error("cannot use the state directory: %s", e)
        return 1
    try:
        mcu = Mcu(args.device)
    except OSError as e:
        log.error("cannot open %s: %s", args.device, e)
        return 1
    # Do not give up if the MCU is not answering right now (e.g. after suspend):
    # stay on the bus, and retry whenever a client uses the device.
    try:
        mcu.ensure_seed(store.seed, store.seed_is_new)
        store.seed_is_new = False
    except McuError as e:
        log.warning("MCU not ready yet (%s); will retry when the device is used", e)

    node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
    mgr_info = node.lookup_interface(MGR_IFACE)
    dev_info = node.lookup_interface(DEV_IFACE)
    loop = GLib.MainLoop()

    def on_bus(conn, name):
        svc = Service(conn, mcu, store)
        conn.register_object(MGR_PATH, mgr_info, svc.manager_call, None, None)
        conn.register_object(DEV_PATH, dev_info, svc.device_call, svc.get_property, None)
        conn.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                              "/org/freedesktop/DBus", None, Gio.DBusSignalFlags.NONE,
                              svc.on_name_owner_changed)

    def on_acquired(conn, name):
        log.info("acquired %s", name)

    lost = []

    def on_lost(conn, name):
        log.error("lost or could not acquire %s (is the stock fprintd running?)", name)
        lost.append(True)
        loop.quit()

    bus = BUS_TYPE
    Gio.bus_own_name(bus, BUS_NAME, Gio.BusNameOwnerFlags.NONE, on_bus, on_acquired, on_lost)
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    return 1 if lost else 0


if __name__ == "__main__":
    sys.exit(main())
